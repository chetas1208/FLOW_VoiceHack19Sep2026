# Copy to .env and replace every __CHANGE_ME__ value.
# Never commit .env or paste live provider keys into this file.

# Neon Postgres / Neon Auth control-plane database.
DATABASE_URL=postgresql://__USER__:__PASSWORD__@__NEON_HOST__/neondb?sslmode=require&channel_binding=require

# FLOW access-token signing key; use at least 32 random characters.
FLOW_ACCOUNT_SIGNING_KEY=__CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET__

# Nebius API. Keep this server-side; do not expose it as a VITE_* variable.
NEBIUS_API_KEY=__CHANGE_ME_NEBIUS_API_KEY__
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_MODEL=Qwen/Qwen3-VL-4B-Instruct

# ElevenLabs API. Keep this server-side; do not expose it as a VITE_* variable.
ELEVENLABS_API_KEY=__CHANGE_ME_ELEVENLABS_API_KEY__
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_VOICE_ID=__CHANGE_ME_ELEVENLABS_VOICE_ID__
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# FLOW runtime defaults.
FLOW_ACCOUNT_URL=https://flow-session-intelligence.vercel.app
FLOW_SECRET_BACKEND=auto
FLOW_STORE_SCREENSHOTS=false

# Optional local API settings.
# QA_API_TOKEN=__CHANGE_ME_LOCAL_ONLY_TOKEN__
# FLOW_CONFIG_DIR=~/.config/flow
# FLOW_DATA_DIR=~/.local/share/flow
