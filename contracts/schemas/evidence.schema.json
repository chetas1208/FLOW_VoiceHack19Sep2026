{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofhound.example/schemas/evidence.schema.json",
  "title": "evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "run_id",
    "kind",
    "uri",
    "sha256",
    "collected_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "trace",
        "state_snapshot",
        "artifact",
        "log",
        "screenshot",
        "assertion_output"
      ]
    },
    "uri": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "redacted": {
      "type": "boolean"
    }
  }
}
