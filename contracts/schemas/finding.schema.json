{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofhound.example/schemas/finding.schema.json",
  "title": "finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "finding_id",
    "run_id",
    "verdict_id",
    "summary",
    "status",
    "evidence_ids"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "finding_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "verdict_id": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "suspected",
        "confirmed",
        "dismissed"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "component_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
