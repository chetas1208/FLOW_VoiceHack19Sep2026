{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentgraph.example/schemas/project.schema.json",
  "title": "project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "tenant_id",
    "name",
    "application_type"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "application_type": {
      "enum": [
        "fullstack",
        "agentic",
        "hybrid"
      ]
    },
    "repository_url": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
