{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentgraph.example/schemas/requirement.schema.json",
  "title": "requirement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "requirement_id",
    "project_id",
    "description",
    "status",
    "source"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "requirement_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "proposed",
        "approved",
        "rejected"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "reference"
      ],
      "properties": {
        "kind": {
          "enum": [
            "documentation",
            "code",
            "user",
            "runtime",
            "inference"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "critical": {
      "type": "boolean"
    }
  }
}
