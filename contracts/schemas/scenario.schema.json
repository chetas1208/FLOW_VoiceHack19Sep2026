{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofhound.example/schemas/scenario.schema.json",
  "title": "scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "project_id",
    "version_id",
    "objective",
    "category",
    "requirement_ids",
    "fixture_id",
    "assertions",
    "limits"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "version_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "fullstack",
        "agentic",
        "hybrid"
      ]
    },
    "requirement_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "fixture_id": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "object"
    },
    "faults": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assertion_id",
          "kind",
          "expected"
        ],
        "properties": {
          "assertion_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "state",
              "api",
              "trace",
              "semantic",
              "security"
            ]
          },
          "expected": {}
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "limits": {
      "type": "object",
      "required": [
        "timeout_seconds",
        "max_cost_usd"
      ],
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_cost_usd": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
