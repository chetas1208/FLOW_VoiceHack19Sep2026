{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentgraph.example/schemas/test-run.schema.json",
  "title": "test-run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "scenario_id",
    "version_id",
    "environment_id",
    "status",
    "started_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "version_id": {
      "type": "string",
      "minLength": 1
    },
    "environment_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "completed",
        "infra_error",
        "cancelled"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "trace_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
