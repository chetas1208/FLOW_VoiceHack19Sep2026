{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofhound.example/schemas/trace-reference.schema.json",
  "title": "trace-reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "trace_id",
    "service_name"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "service_name": {
      "type": "string",
      "minLength": 1
    },
    "span_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    }
  }
}
