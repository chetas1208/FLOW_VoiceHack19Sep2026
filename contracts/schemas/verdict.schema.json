{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofhound.example/schemas/verdict.schema.json",
  "title": "verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verdict_id",
    "run_id",
    "status",
    "assertion_results",
    "evidence_ids"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "verdict_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE",
        "INFRA_ERROR"
      ]
    },
    "assertion_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assertion_id",
          "status"
        ],
        "properties": {
          "assertion_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "INCONCLUSIVE",
              "INFRA_ERROR"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reason": {
      "type": "string"
    },
    "evaluator_version": {
      "type": "string",
      "minLength": 1
    }
  }
}
