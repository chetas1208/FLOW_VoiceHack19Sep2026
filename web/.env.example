# Base URL of the FLOW cloud API (no trailing slash, no /v1).
VITE_API_URL=http://localhost:8080
# local = POST /v1/dev/login (development only); oidc = authorization code + PKCE against your IdP.
VITE_AUTH_MODE=local
# --- OIDC (only when VITE_AUTH_MODE=oidc) ---
VITE_OIDC_ISSUER=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_SCOPE=openid email profile
# Optional: API audience for IdPs that need it (e.g. Auth0).
VITE_OIDC_AUDIENCE=
# Defaults to <origin>/auth/callback. Register this exact URL with the IdP.
VITE_OIDC_REDIRECT_URI=
# Which token the FLOW API verifies: access | id
VITE_OIDC_TOKEN_USE=access
